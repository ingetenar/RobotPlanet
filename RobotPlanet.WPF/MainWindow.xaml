<Window x:Class="RobotPlanet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="294"/>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Lisa uus robot"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Roboti nimi" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox"
                         Height="32"
                         Padding="7"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Roboti tüüp" Margin="0,0,0,5"/>
                <ComboBox x:Name="RobotTypeComboBox"
                          Height="32"
                          SelectedIndex="0">
                    <ComboBoxItem Content="CleanerBot"/>
                    <ComboBoxItem Content="ExplorerBot"/>
                    <ComboBoxItem Content="RepairBot"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Algenergia" Margin="0,0,0,5"/>
                <TextBox x:Name="EnergyTextBox"
                         Height="32"
                         Padding="7"
                         Text="100"/>
            </StackPanel>

            <Button Grid.Row="4"
                    x:Name="AddRobotButton"
                    Content="Lisa robot"
                    Height="38"
                    Margin="0,0,0,18"
                    Click="AddRobotButton_Click"/>

            <GroupBox Grid.Row="5" Header="Robotid">
                <ListBox x:Name="RobotsListBox"
                         Margin="8"
                         SelectionChanged="RobotsListBox_SelectionChanged"/>
            </GroupBox>

            <Button Grid.Row="6"
                    x:Name="RemoveRobotButton"
                    Content="Eemalda valitud robot"
                    Height="38"
                    Margin="0,15,0,0"
                    Click="RemoveRobotButton_Click"/>
        </Grid>

        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Valitud roboti andmed"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <Border Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock x:Name="SelectedRobotTextBlock"
                               Text="Robot pole valitud."
                               FontSize="16"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Energia"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <ProgressBar x:Name="EnergyProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="24"/>

                    <TextBlock x:Name="EnergyTextBlock"
                               Text="0/100"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2"
                         Columns="2"
                         Margin="0,0,0,10">
                <Button Content="Tavaline tegevus"
                        Height="42"
                        Margin="4"
                        Click="PerformActionButton_Click"/>

                <Button Content="Crazy Action"
                        Height="42"
                        Margin="4"
                        Click="CrazyActionButton_Click"/>

                <Button Content="Laadi +10"
                        Height="42"
                        Margin="4"
                        Click="ChargeButton_Click"/>

                <Button Content="Skaneeri"
                        Height="42"
                        Margin="4"
                        Click="ScanButton_Click"/>

                <Button Content="Paranda"
                        Height="42"
                        Margin="4"
                        Click="RepairButton_Click"/>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="Tegevuste logi"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,10,0,8"/>

            <ListBox Grid.Row="4"
                     x:Name="LogListBox"/>
        </Grid>
    </Grid>
</Window>