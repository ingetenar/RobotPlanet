<Window x:Class="RobotPlanet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet Vol.3"
        Height="900"
        Width="1250"
        MinHeight="720"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="20">

            <Grid Height="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Lisa uus robot"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,12">

                        <TextBlock Text="Roboti nimi"
                                   Margin="0,0,0,5"/>

                        <TextBox Height="32"
                                 Padding="7"
                                 Text="{Binding NewRobotName,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,12">

                        <TextBlock Text="Roboti tüüp ja hoidla"
                                   Margin="0,0,0,5"/>

                        <ComboBox Height="32"
                                  ItemsSource="{Binding RepositoryNames}"
                                  SelectedItem="{Binding SelectedRepositoryName,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,12">

                        <TextBlock Text="Algenergia"
                                   Margin="0,0,0,5"/>

                        <TextBox Height="32"
                                 Padding="7"
                                 Text="{Binding NewRobotEnergy,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Row="4"
                            Content="Lisa robot"
                            Height="38"
                            Margin="0,0,0,15"
                            Command="{Binding AddCommand}"/>

                    <StackPanel Grid.Row="5"
                                Margin="0,0,0,12">

                        <TextBlock Text="Otsi nime järgi"
                                   Margin="0,0,0,5"/>

                        <TextBox Height="32"
                                 Padding="7"
                                 Text="{Binding SearchText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="6"
                              Header="Valitud hoidla robotid">

                        <ListBox Margin="8"
                                 ItemsSource="{Binding Robots}"
                                 SelectedItem="{Binding SelectedRobot,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text=" – "/>

                                        <TextBlock Text="{Binding Energy,
                                                                Mode=OneWay}"/>

                                        <TextBlock Text="/100"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <Button Grid.Row="7"
                            Content="Eemalda valitud robot"
                            Height="38"
                            Margin="0,15,0,0"
                            Command="{Binding RemoveCommand}"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Valitud roboti andmed"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Border Grid.Row="1"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRobotDetails,
                                                    Mode=OneWay}"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Energia"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding SelectedRobot.Energy,
                                                         Mode=OneWay,
                                                         TargetNullValue=0,
                                                         FallbackValue=0}"
                                         Height="24"/>

                            <TextBlock Text="{Binding SelectedRobotEnergyText,
                                                    Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Margin="0,0,0,10">

                        <Button Content="Tavaline tegevus"
                                Height="42"
                                Margin="4"
                                Command="{Binding PerformActionCommand}"/>

                        <Button Content="Crazy Action"
                                Height="42"
                                Margin="4"
                                Command="{Binding CrazyActionCommand}"/>

                        <Button Content="Laadi +10"
                                Height="42"
                                Margin="4"
                                Command="{Binding ChargeCommand}"/>

                        <Button Content="Skaneeri"
                                Height="42"
                                Margin="4"
                                Command="{Binding ScanCommand}"/>

                        <Button Content="Paranda"
                                Height="42"
                                Margin="4"
                                Command="{Binding RepairCommand}"/>

                        <Button Content="Rakenda LINQ päringud"
                                Height="42"
                                Margin="4"
                                Command="{Binding ApplyLinqCommand}"/>
                    </UniformGrid>

                    <TextBlock Grid.Row="3"
                               Text="LINQ kokkuvõte tüüpide järgi"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,8,0,6"/>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding SummaryResults}"/>

                    <TextBlock Grid.Row="5"
                               Text="Tegevuste ja reaktsioonide logi"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,12,0,8"/>

                    <ListBox Grid.Row="6"
                             ItemsSource="{Binding LogMessages}"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <GroupBox Header="Robot Planet Vol.3 – CPU Simulation"
                      Margin="0,25,0,20"
                      Padding="15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="1. Vali vähemalt kolm robotit"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Height="230"
                                Margin="0,0,0,15">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SimulationRobotOptions}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected,
                                                                          Mode=TwoWay,
                                                                          UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="4"
                                                      FontSize="14"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="2. CPU töömaht"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox Height="34"
                                 Padding="7"
                                 Margin="0,0,0,12"
                                 Text="{Binding SimulationWorkload,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="Simulate error for the first robot"
                                  IsChecked="{Binding SimulateError,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,15"/>

                        <UniformGrid Columns="2"
                                     Margin="0,0,0,8">

                            <Button Content="Run Sequential"
                                    Height="42"
                                    Margin="3"
                                    Command="{Binding RunSequentialCommand}"/>

                            <Button Content="Run Parallel"
                                    Height="42"
                                    Margin="3"
                                    Command="{Binding RunParallelCommand}"/>
                        </UniformGrid>

                        <Button Content="Cancel"
                                Height="42"
                                Margin="3"
                                Command="{Binding CancelSimulationCommand}"/>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Simulation results"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Border Grid.Row="1"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,10">

                            <StackPanel>
                                <TextBlock Text="{Binding SimulationStatus}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding TotalSimulationTime}"
                                           FontSize="15"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="Robot | Status | Final state | Result | Duration"
                                   FontWeight="Bold"
                                   Margin="4,0,4,6"/>

                        <ListBox Grid.Row="3"
                                 Height="390"
                                 ItemsSource="{Binding SimulationResults}"
                                 HorizontalContentAlignment="Stretch">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Margin="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>