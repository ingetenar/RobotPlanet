<Window x:Class="RobotPlanet.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet Vol.2"
        Height="820"
        Width="1200"
        MinHeight="720"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: добавление, поиск и список роботов -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Lisa uus robot"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,12">

                <TextBlock Text="Roboti nimi"
                           Margin="0,0,0,5"/>

                <TextBox Height="32"
                         Padding="7"
                         Text="{Binding NewRobotName,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,12">

                <TextBlock Text="Roboti tüüp ja hoidla"
                           Margin="0,0,0,5"/>

                <ComboBox Height="32"
                          ItemsSource="{Binding RepositoryNames}"
                          SelectedItem="{Binding SelectedRepositoryName,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0,0,0,12">

                <TextBlock Text="Algenergia"
                           Margin="0,0,0,5"/>

                <TextBox Height="32"
                         Padding="7"
                         Text="{Binding NewRobotEnergy,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Grid.Row="4"
                    Content="Lisa robot"
                    Height="38"
                    Margin="0,0,0,15"
                    Command="{Binding AddCommand}"/>

            <StackPanel Grid.Row="5"
                        Margin="0,0,0,12">

                <TextBlock Text="Otsi nime järgi"
                           Margin="0,0,0,5"/>

                <TextBox Height="32"
                         Padding="7"
                         Text="{Binding SearchText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <GroupBox Grid.Row="6"
                      Header="Valitud hoidla robotid">

                <ListBox Margin="8"
                         ItemsSource="{Binding Robots}"
                         SelectedItem="{Binding SelectedRobot,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text=" – "/>

                                <TextBlock Text="{Binding Energy,
                                                        Mode=OneWay}"/>

                                <TextBlock Text="/100"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Button Grid.Row="7"
                    Content="Eemalda valitud robot"
                    Height="38"
                    Margin="0,15,0,0"
                    Command="{Binding RemoveCommand}"/>
        </Grid>

        <!-- Правая часть: состояние, действия, LINQ и журнал -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Valitud roboti andmed"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <Border Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="{Binding SelectedRobotDetails,
                                            Mode=OneWay}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Energia"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding SelectedRobot.Energy,
                                                 Mode=OneWay,
                                                 TargetNullValue=0,
                                                 FallbackValue=0}"
                                 Height="24"/>

                    <TextBlock Text="{Binding SelectedRobotEnergyText,
                                            Mode=OneWay}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2"
                         Columns="3"
                         Margin="0,0,0,10">

                <Button Content="Tavaline tegevus"
                        Height="42"
                        Margin="4"
                        Command="{Binding PerformActionCommand}"/>

                <Button Content="Crazy Action"
                        Height="42"
                        Margin="4"
                        Command="{Binding CrazyActionCommand}"/>

                <Button Content="Laadi +10"
                        Height="42"
                        Margin="4"
                        Command="{Binding ChargeCommand}"/>

                <Button Content="Skaneeri"
                        Height="42"
                        Margin="4"
                        Command="{Binding ScanCommand}"/>

                <Button Content="Paranda"
                        Height="42"
                        Margin="4"
                        Command="{Binding RepairCommand}"/>

                <Button Content="Rakenda LINQ päringud"
                        Height="42"
                        Margin="4"
                        Command="{Binding ApplyLinqCommand}"/>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="LINQ kokkuvõte tüüpide järgi"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,8,0,6"/>

            <ListBox Grid.Row="4"
                     ItemsSource="{Binding SummaryResults}"/>

            <TextBlock Grid.Row="5"
                       Text="Tegevuste ja reaktsioonide logi"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,12,0,8"/>

            <ListBox Grid.Row="6"
                     ItemsSource="{Binding LogMessages}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>